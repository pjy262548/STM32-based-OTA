; STM32F103VET6 OTA App B scatter file
; App B starts at 0x08040000 and has 240KB.

LR_IROM1 0x08040000 0x0003C000  {
  ER_IROM1 0x08040000 0x0003C000  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
    .ANY (+XO)
  }
  ER_RAMFUNC 0x20000000 0x00000800  {
    *.o (.ramfunc)
  }
  RW_IRAM1 0x20000800 0x0000F800  {
    .ANY (+RW +ZI)
  }
}
